*.lnk

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local notes between you and your editor/agent (not for version control)
.local.note/

# Vosk Windows 配布物（build.rs が GitHub から取得・キャッシュ。リポジトリには含めない）
.vendors/

# for local test only files
**/*.local
**/*.local.*
*.ron
*.wav

# Phase VI-β: Web GUI (gui/)
gui/node_modules/
gui/dist/
gui/.svelte-kit/
gui/.vite/
gui/*.log
gui/.env
gui/.env.*
!gui/.env.example
