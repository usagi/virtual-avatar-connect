{
 "compilerOptions": {
  "target": "es2023",
  "lib": ["ES2023", "DOM"],
  "module": "esnext",
  "moduleResolution": "bundler",
  "types": ["node", "@playwright/test"],
  "strict": true,
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "skipLibCheck": true,
  "noEmit": true,
  "resolveJsonModule": true,
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true
 },
 "include": ["**/*.ts"]
}
