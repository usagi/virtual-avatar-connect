meta {
  name: Regex entry remove
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/control/modify/dict-for-subtitles/regex/entries
  body: json
  auth: inherit
}

body:json {
  {
    "replacement": "ワロタ",
    "pattern": "^\\s*lol\\s*$"
  }
}

docs {
  対象 Modify プロセッサの `writable_regex_file` から (replacement, pattern) 完全一致の行を削除する。
  削除があった場合のみ WS `/events` に `Reloaded` が流れる。
}
